#!/bin/sh
# GAIA CLI Launcher
# Usage: ./bin/gaia [options]

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")

cd "$PROJECT_ROOT" || exit 1

# 1. Setup Trajectory
TRAJ="trajectories-$(date +%Y%m%d%H%M%S).jsonl"
echo "$TRAJ" > .last_trajectory
export GAIA_TRAJECTORIES_FILE="$TRAJ"

echo "Starting GAIA CLI. Trajectory will be saved to: $TRAJ"

# 2. Run Rust Client
eval "$(guix shell -m guix.scm --search-paths)"
exec cargo run --manifest-path src/gaia-cli/Cargo.toml --release
