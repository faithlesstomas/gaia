#!/bin/sh
# GAIA Launcher
# Usage: ./bin/gaia [options]
# Environment variables:
#   GAIA_MODEL      - Model name (default: ministral-3b)
#   RAI_BACKEND     - Backend type (default: ollama)
#   RAI_URL         - RAI Server URL (default: http://localhost:8000)

# Ensure script is run from project root or adjust paths
SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")

cd "$PROJECT_ROOT" || exit 1

echo "Starting GAIA..."
echo "  Model: ${GAIA_MODEL:-ministral-3b}"
echo "  Backend: ${RAI_BACKEND:-ollama}"
echo "  URL: ${RAI_URL:-http://localhost:8000}"

# Execute via Guix Shell
exec guix shell -m guix.scm -- guile -L scheme -e '(@@ (gaia core) start-gaia)' -- "$@"
