#!/bin/sh
# GAIA Launcher
# Usage: ./bin/gaia [options]

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")

cd "$PROJECT_ROOT" || exit 1

# 1. Ensure LLM server is running
make llm-server

# 2. Setup Trajectory
TRAJ="trajectories-$(date +%Y%m%d%H%M%S).jsonl"
echo "$TRAJ" > .last_trajectory
export GAIA_TRAJECTORIES_FILE="$TRAJ"

echo "Starting GAIA. Trajectory will be saved to: $TRAJ"

# 3. Setup Guix Environment and Execute Guile directly
# We use --search-paths and eval to load the environment into the current shell.
# Then we 'exec guile' directly. This prevents 'guix shell' from acting as a 
# parent process that intercepts and dies on SIGINT (Ctrl-C), leaving Guile orphaned.
eval "$(guix shell -m guix.scm --search-paths)"
exec guile -L scheme scripts/run-gaia.scm "$@"
