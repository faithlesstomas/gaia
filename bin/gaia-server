#!/bin/sh
eval "$(guix shell -m guix.scm --search-paths 2>/dev/null || true)"
exec guile -L src -s "$0" "$@"
!#
(use-modules (gaia server))

(display "[GAIA] Ensuring LLM proxy server is running...\n")
(system* "make" "llm-server")

(let ((socket-path "/tmp/gaia.sock"))
  (start-server socket-path))
